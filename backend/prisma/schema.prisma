generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FINOPS_VIEWER
}

enum Environment {
  DEV
  PRE
  PRO
}

enum ExecutionStatus {
  SUCCESS
  ERROR
  TIMEOUT
  RATE_LIMIT_EXCEEDED
}

enum BatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  users       User[]
  aiAgents    AiAgent[]
}

model Department {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  users          User[]
  aiAgents       AiAgent[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  name           String?
  passwordHash   String?
  role           Role           @default(FINOPS_VIEWER)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  executionLogs  ExecutionLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model AiAgent {
  id             String         @id @default(uuid())
  name           String
  description    String?
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  status         String         @default("ACTIVE")
  executionLogs  ExecutionLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ModelPrice {
  id                   String   @id @default(uuid())
  provider             String
  model                String
  promptPricePer1k     Decimal  @db.Decimal(10, 6)
  completionPricePer1k Decimal  @db.Decimal(10, 6)
  effectiveFrom        DateTime @default(now())
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([provider, model, effectiveFrom])
}

model IngestionBatch {
  id               String         @id @default(uuid())
  fileName         String
  fileSizeBytes    Int?
  totalRecords     Int            @default(0)
  processedRecords Int            @default(0)
  failedRecords    Int            @default(0)
  errorSummary     String?
  status           BatchStatus    @default(PENDING)
  executionLogs    ExecutionLog[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ExecutionLog {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  agentId          String?
  agent            AiAgent?        @relation(fields: [agentId], references: [id])
  batchId          String?
  batch            IngestionBatch? @relation(fields: [batchId], references: [id])
  environment      Environment     @default(PRO)
  provider         String
  model            String
  promptTokens     Int             @default(0)
  completionTokens Int             @default(0)
  totalTokens      Int             @default(0)
  latencyMs        Int             @default(0)
  costUsd          Decimal         @db.Decimal(12, 6)
  inputCost        Decimal?        @db.Decimal(12, 6)
  outputCost       Decimal?        @db.Decimal(12, 6)
  status           ExecutionStatus @default(SUCCESS)
  metadata         Json?
  executedAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@index([executedAt])
  @@index([userId])
  @@index([agentId])
  @@index([environment])
}
